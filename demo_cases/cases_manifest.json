          "SOURCE_MISMATCH",
          "EVIDENCE_REFERENCE_MISSING",
          "PLACEHOLDER_REMAINING",
          "CLIENT_PROFILE_MISMATCH"
        ],
        "expected_llm_mode": "mock",
        "expected_fallback_reason": "no_api_key",
        "expected_retrieval_statuses": {
          "client": "matched"
        },
        "expected_privacy_summary": true
      }
    },
